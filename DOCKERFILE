# 1. Usar una imagen base de Python limpia y ligera
FROM python:3.11-slim

# 2. Establecer el directorio de trabajo dentro del contenedor
WORKDIR /app

# 3. Copiar todos tus archivos del proyecto al contenedor
COPY . .

# 4. Instalar todas las dependencias de tu proyecto
RUN pip install -r requirements.txt

# 5. (Opcional pero recomendado) Instalar watchdog para un mejor rendimiento
RUN pip install watchdog

# 6. Hacer ejecutable nuestro script de arranque (que crearemos en el Paso 2)
RUN chmod +x startup.sh

# 7. Exponer los puertos que usan nuestras apps
EXPOSE 8000  
EXPOSE 8501  

# 8. El comando que se ejecutará al iniciar el contenedor
CMD ["./startup.sh"]